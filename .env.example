# ClaimSense AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to source control.

# ── Supabase ────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in: Project Settings → API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (found in: Project Settings → API → anon public)
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Your Supabase project ID (the subdomain portion of the URL)
VITE_SUPABASE_PROJECT_ID=your-project-ref

# ── Gemini API (used by Supabase Edge Functions — set as a Supabase Secret) ──
# Generate at: https://aistudio.google.com/apikey
# Add via: Supabase Dashboard → Edge Functions → Manage Secrets
# NOT needed in this .env file — edge functions read it from Supabase Secrets.
# GEMINI_API_KEY=AIzaSy...

# ── Lovable Platform (used by Supabase Edge Functions) ──────────────────────
# Required by the retrieve edge function (ai.gateway.lovable.dev)
# Add via: Supabase Dashboard → Edge Functions → Manage Secrets
# NOT needed in this .env file.
# LOVABLE_API_KEY=your-lovable-key
